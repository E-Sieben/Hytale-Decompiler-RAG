# Set these in your Vercel project → Settings → Environment Variables
# (or in .env.local for local Next.js dev)
#
# These are only used by the server-side /api/rag route (never exposed to the browser).
# Users who want to provide their own credentials can do so in the UI (Qdrant custom mode).

QDRANT_URL=https://your-cluster-id.cloud.qdrant.io
QDRANT_API_KEY=your-api-key-here
